# --- Discord (Developer Portalで発行。3ゲーム共通の1アプリ) ---
TOKEN=
OWNER_ID=
# 指定するとスラッシュコマンドをそのサーバーへ即時反映(空ならグローバル。反映に最大1時間)
SERVER_ID=
# ツムツムの内部ログ(管理者向け)の送信先。空なら送らない
LOG_CHANNEL_ID=

# --- Xaccount-Bot 管理画面連携(「代行管理」タブ) ---
# このBotは外部からの接続を受けません。Xaccount-Bot(Cloudflare Worker)へ約10秒ごとに問い合わせに行きます。
# Xaccount-Bot の URL(管理サイトの VITE_API_BASE_URL と同じ https://... のorigin。パスなし)
XACCOUNT_BOT_URL=
# Xaccount-BotのBot-Factory欄「Discord-Cheat連携 Secret」と同じ値(32文字以上)。
# `python scripts/setup.py` が自動生成して表示します。
CHEAT_BRIDGE_SECRET=

# --- ツムツム ---
TSUM_DEBUG=0
TSUM_GACHA_DEBUG=0
TSUM_APP_VER=12.8.1
TSUM_RES_VER=12.8.0
TSUM_GACHA_MAX_CALLS=500
